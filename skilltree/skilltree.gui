	windowDef CloseButton
	{
		rect 400,435,100,30
		backcolor 0.2, 0.2, 0.2, 1
		borderSize 1
		borderColor 1,1,1,1
		text "Reset Skills"
		textAlign 1
		textScale 0.3
		forecolor 1,1,1,1
		font "fonts/chain"

		onMouseEnter {
			set "CloseButton::backcolor" "0.5, 0.5 ,0.5, 1";
		}
		onMouseExit {
			set "CloseButton::backcolor" "0.2, 0.2, 0.2, 1";
		}
		onActionRelease {
			set "cmd" "resetSkillTree";
		}
	}	

